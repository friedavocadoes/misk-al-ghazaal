# --- Supabase (required for Phase 2 backend) ---
# 1. Create project at https://supabase.com/dashboard → New project
# 2. Settings → API Keys → "Publishable and secret API keys" tab.
#    Older projects: hit "Create new API keys" first (safe — legacy keys keep
#    working alongside). Legacy `anon` / `service_role` (eyJ…) are deprecated
#    end of 2026 — use the sb_publishable_ / sb_secret_ keys below.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 3. Secret key (SECRET — server only, never commit, never NEXT_PUBLIC_):
#    Used ONLY in Server Actions / Route Handlers (checkout order writes + stock RPC).
SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Legacy fallback (optional, only if you haven't migrated Dashboard keys) ---
# Code prefers the new vars above and falls back to these when set:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- Site URL (production fallback for non-browser contexts) ---
# Auth redirects sent FROM the browser always use the page's own origin
# (exact by definition — a stale value here can never hijack them).
# Supabase still only honours those origins when allowlisted in
# Dashboard → Authentication → URL Configuration → Redirect URLs —
# otherwise it falls back to the Site URL and logins bounce to the wrong
# domain (e.g. localhost:3000). See SETUP_SUPABASE.md §6c.
# NEXT_PUBLIC_SITE_URL=https://miskalghazaalperfumes.com

# --- Optional ---
# Restrict admin signup to an invite token checked by /api/admin/invite:
# ADMIN_INVITE_TOKEN=choose-a-long-random-string

# --- Email: one shared SMTP connection for all senders ---
# SMTP_HOST=miskalghazaalperfumes.com
# SMTP_PORT=465
# SMTP_SECURE=1
# Mailbox login and optional FROM address only (FROM defaults to USER).
# Welcome emails
# HELLO_SMTP_USER=hello@miskalghazaalperfumes.com
# HELLO_SMTP_PASS=your-mailbox-password
# HELLO_SMTP_FROM=hello@miskalghazaalperfumes.com

# Order confirmations and status updates
# NOREPLY_SMTP_USER=noreply@miskalghazaalperfumes.com
# NOREPLY_SMTP_PASS=your-mailbox-password
# NOREPLY_SMTP_FROM=noreply@miskalghazaalperfumes.com

# Opt-in campaigns
# PROMO_SMTP_USER=promo@miskalghazaalperfumes.com
# PROMO_SMTP_PASS=your-mailbox-password
# PROMO_SMTP_FROM=promo@miskalghazaalperfumes.com

# Customer order-issue messages
# ORDERS_SMTP_USER=orders@miskalghazaalperfumes.com
# ORDERS_SMTP_PASS=your-mailbox-password
# ORDERS_SMTP_FROM=orders@miskalghazaalperfumes.com

# Optional single-login fallback: SMTP_USER / SMTP_PASS / SMTP_FROM
# SUPPORT_EMAIL=support@miskalghazaalperfumes.com

# --- Checkout map tiles (optional) ---
# CARTO basemaps need a FREE key since Sep 2026 (get one in a minute at
# https://carto.com/basemaps/apikey — no account, no card). Without it the
# map uses Esri light-gray tiles (no key needed, still elegant):
# NEXT_PUBLIC_CARTO_KEY=your-carto-key

# --- Tap Payments (server only) ---
# Apply supabase/migration_tap_checkout.sql. See docs/guides/TAP_PAYMENTS_SETUP.md.
# TAP_SECRET_KEY=sk_test_your_secret_key
# TAP_SITE_URL=https://your-public-checkout-host.example
# Optional merchant override if Tap provides a numeric Merchant ID.
# TAP_MERCHANT_ID=
# Enable the methods Tap activated for this account and environment.
# TAP_PAYMENT_METHODS=card,apple_pay,tabby,tamara
# Tamara needs the confirmed UAE merchant limits before it becomes selectable.
# TAP_TAMARA_MIN_AED=
# TAP_TAMARA_MAX_AED=
# Optional account-specific limits. Tabby has a documented AED 10 floor.
# TAP_TABBY_MIN_AED=
# TAP_TABBY_MAX_AED=
# TAP_CARD_MIN_AED=
# TAP_CARD_MAX_AED=
# TAP_APPLE_PAY_MIN_AED=
# TAP_APPLE_PAY_MAX_AED=

# --- WhatsApp: direct Meta Cloud API (server only) ---
# Apply migration_whatsapp.sql then migration_notification_control.sql; see WHATSAPP_SETUP.md for templates,
# pricing, permissions, webhook and scheduled-worker setup. Disabled by default.
# WHATSAPP_ENABLED=0
# WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-numeric-phone-number-id
# WHATSAPP_API_VERSION=vXX.X
# WHATSAPP_ORDER_TEMPLATE=misk_order_update
# WHATSAPP_CONFIRMATION_TEMPLATE=misk_order_confirmed
# WHATSAPP_TRACKING_TEMPLATE=misk_order_tracking
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_APP_SECRET=from-meta-app-settings-basic
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-secret
# CRON_SECRET=choose-another-long-random-secret

# --- Staff Telegram alerts (BotFather → /newbot) ---
# TELEGRAM_BOT_TOKEN=your-botfather-bot-token
# TELEGRAM_CHAT_ID=your-private-or-group-chat-id
# Optional: a topic in a Telegram forum group
# TELEGRAM_MESSAGE_THREAD_ID=123

# Newsletter rate-limit/IP-cache hashing (server only; random 32+ byte value).
# COMMUNICATION_PREFERENCES_SECRET=generate-a-long-random-secret
# IPWhois free fallback/check: default enabled, <=950 new IP lookups/day in DB.
# Optional IP geolocation fallback when trusted edge country is unavailable.
# ANALYTICS_IP_LOOKUP=1
# Enable collection in local development or previews only with a separate analytics database.
# ANALYTICS_ENABLE_NON_PRODUCTION=1
# Only outside Vercel, when your reverse proxy overwrites these headers:
# ANALYTICS_TRUST_PROXY=cloudflare
# Or: ANALYTICS_TRUST_PROXY=custom (trusted x-real-ip)

# Public merchant disclosures for the legal pages. Use the registered details.
STORE_LEGAL_NAME=
STORE_LEGAL_NAME_AR=
STORE_LEGAL_ADDRESS=
STORE_LEGAL_ADDRESS_AR=
STORE_TRADE_LICENCE=
STORE_TRADE_LICENCE_URL=
STORE_LICENSING_AUTHORITY=
STORE_LICENSING_AUTHORITY_AR=

# Optional Google Identity Services button. Public OAuth web client ID only.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
